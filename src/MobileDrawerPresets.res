  startTime?: string,
  endTime?: string,
  dateFormat: string,
  handlePresetSelect: HighchartsSharedSharedTypes.dateRangePreset => unit,
  handleStartTimeChange: string => unit,
  handleEndTimeChange: string => unit,
  setSelectedRange: HighchartsSharedSharedTypes.dateRange => unit,
  setStartDate: string => unit,
  setEndDate: string => unit,
  handleCancel: unit => unit,
